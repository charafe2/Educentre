# ============================================================
# Template for the Docker stack. Copy to `.env` on the host —
# Docker Compose reads `.env`, not this file:
#
#     cp .env.docker .env   &&   edit every CHANGE_ME below
#
# This file IS committed to the repository, so it must never
# contain a real secret. Generate values on the server:
#
#   APP_KEY            docker compose exec php-fpm php artisan key:generate --show
#   REVERB_APP_ID      a random integer, e.g. $(shuf -i 100000-999999 -n 1)
#   REVERB_APP_KEY     openssl rand -hex 16
#   REVERB_APP_SECRET  openssl rand -hex 32
#
# REVERB_APP_KEY is PUBLIC — it is sent in the WebSocket URL and
# compiled into the Angular bundle. It must be its own value and
# must never be reused from APP_KEY or REVERB_APP_SECRET.
#
# It must also NEVER contain a colon. Channel auth is sent as
# "{key}:{signature}" and Reverb parses it with Str::after($auth, ':'),
# taking everything after the FIRST colon. A colon in the key shifts
# that split and every private subscription fails with error 4009.
# This is why a "base64:..." value (an APP_KEY) can never work here.
# ============================================================

APP_NAME="SaaS ERP"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=http://localhost

# Set to the previous APP_KEY when rotating, so sessions and any
# already-encrypted payloads stay readable. Comma-separated.
APP_PREVIOUS_KEYS=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saas_erp
DB_USERNAME=saas_erp
DB_PASSWORD=CHANGE_ME

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@saaserp.com"
MAIL_FROM_NAME="${APP_NAME}"

# All three are required. An empty APP_ID or APP_SECRET breaks
# broadcasting from Laravel; a key that matches no configured app
# makes Reverb close the WebSocket handshake with a 500.
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

NGINX_PORT=8000
NGINX_SSL_PORT=8443
