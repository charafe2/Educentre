# Local dev overrides — Docker Compose auto-merges docker-compose.override.yml
# when it's present, so this template is gitignored under that exact name and
# must never be committed or copied onto a server. To use it locally:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
services:

  php-fpm:
    volumes:
      - ./backend:/var/www/html
      # Dependencies and built assets come from the image, not the host:
      # the host copies are incomplete and installing them over a Windows
      # bind mount is prohibitively slow.
      - /var/www/html/vendor
      - /var/www/html/public/build
    environment:
      APP_ENV: local
      APP_DEBUG: true
      LOG_LEVEL: debug

  queue-worker:
    volumes:
      - ./backend:/var/www/html
      # Dependencies and built assets come from the image, not the host:
      # the host copies are incomplete and installing them over a Windows
      # bind mount is prohibitively slow.
      - /var/www/html/vendor
      - /var/www/html/public/build
      - ./docker/supervisor/supervisord.queue.conf:/etc/supervisor/supervisord.queue.conf:ro

  reverb:
    volumes:
      - ./backend:/var/www/html
      # Dependencies and built assets come from the image, not the host:
      # the host copies are incomplete and installing them over a Windows
      # bind mount is prohibitively slow.
      - /var/www/html/vendor
      - /var/www/html/public/build
      - ./docker/supervisor/supervisord.reverb.conf:/etc/supervisor/supervisord.reverb.conf:ro

  nginx:
    volumes:
      - ./backend:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - mailpit

  mailpit:
    image: axllent/mailpit:latest
    container_name: saas-mailpit
    restart: unless-stopped
    ports:
      - "127.0.0.1:1025:1025"
      - "127.0.0.1:8025:8025"
    networks:
      - saas-network
